{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "env": {
        "KOTLIN_VERSION": "1.9.25"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "KOTLIN_VERSION": "1.9.25"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "env": {
        "KOTLIN_VERSION": "1.9.25"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": true
      }
    }
  }
}
